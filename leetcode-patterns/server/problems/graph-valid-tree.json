        "pyType": "int",
        "inputKind": "primitive"
      },
      {
        "name": "edges",
        "pyType": "list[list[int]]",
        "inputKind": "primitive"
      }
    ],
    "returns": "bool"
  },
  "starterCode": "class Solution:\n    def validTree(self, n: int, edges: list[list[int]]) -> bool:\n        # write your solution here\n        pass\n",
  "equality": "exact",
