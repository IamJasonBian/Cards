{
  "slug": "word-search-ii",
  "title": "Word Search II",
  "number": 212,
  "difficulty": "Hard",
  "category": "Tree",
  "url": "https://leetcode.com/problems/word-search-ii/",
  "statement": "Given an m x n board of characters and a list of strings words, return all words on the board.\n\nEach word must be constructed from letters of sequentially adjacent cells, where adjacent cells are horizontally or vertically neighboring. The same letter cell may not be used more than once in a word.",
  "constraints": [
    "m == board.length",
    "n == board[i].length",
    "1 <= m, n <= 12",
    "board[i][j] is a lowercase English letter",
    "1 <= words.length <= 3 * 10^4",
    "1 <= words[i].length <= 10",
    "words[i] consists of lowercase English letters",
    "All strings of words are unique"
  ],
  "signature": {
    "className": "Solution",
    "methodName": "findWords",
    "params": [
      {
        "name": "board",
        "pyType": "list[list[str]]",
        "inputKind": "primitive"
      },
      {
        "name": "words",
        "pyType": "list[str]",
        "inputKind": "primitive"
      }
    ],
    "returns": "list[str]"
  },
  "starterCode": "class Solution:\n    def findWords(self, board: list[list[str]], words: list[str]) -> list[str]:\n        # write your solution here\n        pass\n",
  "equality": "set",
